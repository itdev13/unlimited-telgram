# ── Core ───────────────────────────────────────────────────────
DATABASE_URL="mongodb://localhost:27017/telegram-v2"
PORT=3015
BACKEND_URL="https://your-v2-server.com"
FRONTEND_URL="https://your-v2-frontend.com"

# ── Encryption (32-byte hex) ───────────────────────────────────
ENCRYPTION_KEY=""

# ── GHL app ────────────────────────────────────────────────────
GHL_CLIENT_ID=""
GHL_CLIENT_SECRET=""
GHL_REDIRECT_URI="https://your-v2-server.com/auth/callback"
GHL_SSO_KEY=""
GHL_APP_ID=""
GHL_CONVERSATION_PROVIDER_ID=""
GHL_API_BASE="https://services.leadconnectorhq.com"
GHL_API_VERSION="2021-07-28"

# ── GHL webhook signature ──────────────────────────────────────
GHL_WEBHOOK_ED25519_PUBLIC_KEY=""
GHL_WEBHOOK_LEGACY_PUBLIC_KEY=""
GHL_WEBHOOK_VERIFY_MODE="monitor"   # monitor | enforce

# ── Subscription (v2 billing) ──────────────────────────────────
SUBSCRIPTION_REQUIRED="true"
TRIAL_DAYS="3"
TRIAL_CONVERT_GRACE_DAYS="4"
# Map each GHL planId to a tier. connectionLimit = combined bots + phones ("Telegram
# Accounts"). Replace the planId keys with your REAL GHL plan IDs:
# PLANS_JSON={"<basicPlanId>":{"name":"Basic","priceUsd":12,"connectionLimit":1},"<proPlanId>":{"name":"Pro","priceUsd":30,"connectionLimit":3},"<premiumPlanId>":{"name":"Premium","priceUsd":45,"connectionLimit":5},"<ultimatePlanId>":{"name":"Ultimate","priceUsd":80,"connectionLimit":10}}
PLANS_JSON=""
# Fallback single plan if PLANS_JSON is empty:
PLAN_NAME="Basic"
PLAN_PRICE_USD="12"
PLAN_CONNECTION_LIMIT="1"
# Upgrade deep-link base (agency white-label domain) + version id:
GHL_DEFAULT_APP_DOMAIN="app.gohighlevel.com"
GHL_APP_VERSION_ID=""

# ── Session (SSO → JWT) ────────────────────────────────────────
JWT_SECRET=""
SESSION_TTL="86400"

# ── Telegram (GramJS phone) ────────────────────────────────────
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
GRAMJS_LOG_LEVEL="error"
PHONE_RECONNECT_STAGGER_MS="3000"

# ── Misc ───────────────────────────────────────────────────────
ADMIN_API_KEY=""
DEFAULT_PHONE_COUNTRY_CODE=""
MARKETPLACE_UPGRADE_URL=""

# ── Support (ticket email via Gmail) ───────────────────────────
SUPPORT_EMAIL_USER="binduchowdary856@gmail.com"
SUPPORT_EMAIL_PASSWORD=""
SUPPORT_EMAIL_TO="binduchowdary856@gmail.com"
