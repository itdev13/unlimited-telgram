# ── Core ───────────────────────────────────────────────────────
DATABASE_URL="mongodb://localhost:27017/telegram-v2"
PORT=3002
BACKEND_URL="https://your-v2-server.com"
FRONTEND_URL="https://your-v2-frontend.com"

# ── Encryption (32-byte hex) ───────────────────────────────────
ENCRYPTION_KEY=""

# ── GHL app ────────────────────────────────────────────────────
GHL_CLIENT_ID=""
GHL_CLIENT_SECRET=""
GHL_REDIRECT_URI="https://your-v2-server.com/auth/callback"
GHL_SSO_KEY=""
GHL_APP_ID=""
GHL_CONVERSATION_PROVIDER_ID=""
GHL_API_BASE="https://services.leadconnectorhq.com"
GHL_API_VERSION="2021-07-28"

# ── GHL webhook signature ──────────────────────────────────────
GHL_WEBHOOK_ED25519_PUBLIC_KEY=""
GHL_WEBHOOK_LEGACY_PUBLIC_KEY=""
GHL_WEBHOOK_VERIFY_MODE="monitor"   # monitor | enforce

# ── Subscription (v2 billing) ──────────────────────────────────
SUBSCRIPTION_REQUIRED="true"
TRIAL_DAYS="3"
TRIAL_CONVERT_GRACE_DAYS="4"
# Map each GHL planId to a tier. Example (replace planIds with your real ones):
# PLANS_JSON={"planIdStarter":{"name":"Starter","priceUsd":19,"botLimit":2,"phoneLimit":1},"planIdGrowth":{"name":"Growth","priceUsd":49,"botLimit":3,"phoneLimit":3},"planIdUnlimited":{"name":"Unlimited","priceUsd":99,"botLimit":9999,"phoneLimit":9999}}
PLANS_JSON=""
# Fallback single-plan limits if PLANS_JSON is empty:
PLAN_NAME="Starter"
PLAN_PRICE_USD="19"
PLAN_BOT_LIMIT="2"
PLAN_PHONE_LIMIT="1"
# Upgrade deep-link base (agency white-label domain) + version id:
GHL_DEFAULT_APP_DOMAIN="app.gohighlevel.com"
GHL_APP_VERSION_ID=""

# ── Session (SSO → JWT) ────────────────────────────────────────
JWT_SECRET=""
SESSION_TTL="86400"

# ── Telegram (GramJS phone) ────────────────────────────────────
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
GRAMJS_LOG_LEVEL="error"
PHONE_RECONNECT_STAGGER_MS="3000"

# ── Misc ───────────────────────────────────────────────────────
ADMIN_API_KEY=""
DEFAULT_PHONE_COUNTRY_CODE=""
